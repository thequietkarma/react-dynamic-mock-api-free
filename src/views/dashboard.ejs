<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Dashboard • ReactMockAPI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Fira+Code:wght@400;500&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['Fira Code', 'monospace'] },
                    colors: { glass: 'rgba(255, 255, 255, 0.03)', borderGlass: 'rgba(255, 255, 255, 0.1)' }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #030712;
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
        }

        .mesh-gradient {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: radial-gradient(circle at 0% 0%, #1e1b4b 0%, transparent 35%), radial-gradient(circle at 100% 100%, #312e81 0%, transparent 35%);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .input-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.2s;
        }

        .input-glass:focus {
            border-color: #6366f1;
            outline: none;
            background: rgba(255, 255, 255, 0.08);
        }

        /* IMPROVED RESPONSIVE MODAL */
        #modalOverlay {
            backdrop-filter: blur(8px);
            display: none;
            position: fixed;
            inset: 0;
            z-index: 100;
            background-color: rgba(0, 0, 0, 0.6);
            align-items: center;
            justify-content: center;
            padding: 1rem;
            /* Padding for mobile screens */
        }

        #modalContent {
            max-height: 90vh;
            /* Prevents modal from going off-screen */
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: 42rem;
            /* max-w-2xl */
        }

        #modalBody {
            overflow-y: auto;
            /* Scrollable content inside modal */
            padding-right: 4px;
        }

        /* Custom scrollbar for the modal body */
        #modalBody::-webkit-scrollbar {
            width: 5px;
        }

        #modalBody::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        .animate-in {
            animation: slideUp 0.3s ease-out forwards;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="min-h-screen pb-20">
    <div class="mesh-gradient"></div>

    <nav class="sticky top-0 z-[50] px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center glass-card rounded-2xl px-6 py-3">
            <div class="flex items-center space-x-2">
                <div
                    class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center shadow-lg shadow-indigo-500/20">
                    <i class="fas fa-bolt text-white text-sm"></i>
                </div>
                <span class="text-xl font-bold tracking-tight">Console</span>
            </div>
            <button onclick="logout()"
                class="group flex items-center space-x-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 px-4 py-2 rounded-xl border border-red-500/30 transition-all">
                <span class="text-sm font-bold">Logout</span>
                <i class="fas fa-sign-out-alt text-xs group-hover:translate-x-1 transition-transform"></i>
            </button>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto mt-8 px-6">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="glass-card p-6 rounded-[2rem] relative overflow-hidden">
                <div class="absolute -right-4 -top-4 text-indigo-500/10 text-7xl"><i class="fas fa-layer-group"></i>
                </div>
                <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Total Deployments</p>
                <h2 id="totalApis" class="text-4xl font-black text-white">0</h2>
            </div>
            <div class="glass-card p-6 rounded-[2rem] relative overflow-hidden">
                <div class="absolute -right-4 -top-4 text-purple-500/10 text-7xl"><i class="fas fa-server"></i></div>
                <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Region</p>
                <h2 class="text-xl font-bold text-white flex items-center">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse mr-2"></span> Global Edge
                </h2>
            </div>
            <div class="glass-card p-6 rounded-[2rem] flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Current Plan</p>
                    <h2 class="text-xl font-bold text-indigo-400">Developer (Free)</h2>
                </div>
                <!-- <button class="bg-white/5 hover:bg-white/10 p-3 rounded-2xl border border-white/10 text-xs font-bold transition-all">Upgrade</button> -->
            </div>
        </div>

        <div class="glass-card p-8 rounded-[2.5rem] mb-10 border-indigo-500/20">
            <h2 class="text-xl font-bold mb-6 flex items-center">
                <i class="fas fa-plus-circle mr-2 text-indigo-500"></i> New API Instance
            </h2>
            <form id="createAPIForm" class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Route Name</label>
                    <input type="text" name="rootRoute" placeholder="e.g. my-ecommerce-api" required
                        class="input-glass w-full rounded-xl px-4 py-3 text-sm" />
                </div>
                <div class="space-y-2">
                    <label
                        class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Permissions</label>
                    <div class="input-glass w-full rounded-xl px-4 py-3 text-sm text-gray-400 flex items-center">
                        <i class="fas fa-check-circle text-green-500 mr-2"></i> All Methods Allowed
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">
                        Expiry Date
                    </label>

                    <input type="date" name="expiresAt" id="expiryInput" required
                        class="input-glass w-full rounded-xl px-4 py-3 text-sm" />

                </div>
                <div class="flex items-end">
                    <button id="createBtn"
                        class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg shadow-indigo-500/20 transition-all">
                        Deploy API
                    </button>
                </div>
            </form>
        </div>

        <div>
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold">Your Projects</h2>
                <button onclick="loadDashboard()" class="text-gray-500 hover:text-white transition-colors"><i
                        class="fas fa-sync-alt"></i></button>
            </div>
            <div id="apiList" class="grid grid-cols-1 gap-4"></div>
        </div>
    </div>

    <div id="modalOverlay">
        <div id="modalContent" class="glass-card rounded-[2rem] md:rounded-[2.5rem] p-6 md:p-10 animate-in relative">
            <button onclick="closeModal()"
                class="absolute top-4 right-4 md:top-6 md:right-6 text-gray-500 hover:text-white z-10">
                <i class="fas fa-times text-xl"></i>
            </button>

            <div id="modalBody">
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem("token");
        if (!token) window.location.href = "/login";

        async function loadDashboard() {
            try {
                const res = await fetch("/dashboard/apis-data", { headers: { Authorization: "Bearer " + token } });
                const result = await res.json();
                const data = result.data;

                document.getElementById("totalApis").innerText = data.totalAPIs;
                const container = document.getElementById("apiList");
                container.innerHTML = "";

                if (!data.data || data.data.length === 0) {
                    container.innerHTML = `<div class="text-center py-20 glass-card rounded-[2rem] border-dashed border-2 border-white/5">
                        <p class="text-gray-500">No APIs deployed yet. Start by creating one above!</p>
                    </div>`;
                    return;
                }

                data.data.forEach(api => {
                    const baseURL = window.location.origin;
                    const div = document.createElement("div");
                    div.className = "glass-card p-6 rounded-[2rem] flex flex-col lg:flex-row lg:items-center justify-between gap-6 group border-transparent hover:border-indigo-500/50 transition-all duration-500";
                    div.innerHTML = `
                        <div class="space-y-1">
                            <h3 class="font-bold text-xl text-white group-hover:text-indigo-400 transition-colors">/${api.rootRoute}</h3>
                            <div class="flex items-center space-x-4">
                                <span class="text-[10px] font-mono text-gray-500"><i class="far fa-calendar mr-1"></i> Exp: ${new Date(api.expiresAt).toLocaleDateString()}</span>
                                <span class="text-[10px] font-mono text-green-500 bg-green-500/10 px-2 py-0.5 rounded-full">ACTIVE</span>
                            </div>
                            <div class="mt-3 flex items-center bg-black/30 rounded-lg px-3 py-2 border border-white/5">
                                <code class="text-xs text-indigo-300 font-mono truncate mr-4">${baseURL}/user-api/${api.rootRoute}</code>
                                <button onclick="copyToClipboard('${baseURL}/user-api/${api.rootRoute}')" class="text-gray-500 hover:text-white transition-colors"><i class="far fa-copy"></i></button>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <a href="/dashboard/${api.rootRoute}/view" class="bg-white/5 hover:bg-white/10 px-4 py-2 rounded-xl text-xs font-bold transition-all border border-white/10 flex items-center">
                                <i class="fas fa-database mr-2 text-indigo-400"></i> Data
                            </a>
                            <button onclick="viewEndpoints('${api.rootRoute}')" class="bg-white/5 hover:bg-white/10 px-4 py-2 rounded-xl text-xs font-bold transition-all border border-white/10 flex items-center">
                                <i class="fas fa-code mr-2 text-purple-400"></i> Endpoints
                            </button>
                            <button onclick="showUpdateModal('${api._id}', '${api.rootRoute}')" class="bg-white/5 hover:bg-white/10 px-4 py-2 rounded-xl text-xs font-bold transition-all border border-white/10 flex items-center">
                                <i class="fas fa-edit text-yellow-400"></i>
                            </button>
                            <button onclick="deleteAPI('${api._id}')" class="bg-red-500/10 hover:bg-red-500/20 text-red-400 px-4 py-2 rounded-xl text-xs font-bold transition-all border border-red-500/20">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>`;
                    container.appendChild(div);
                });
            } catch (err) { console.error(err); }
        }

        /* CREATE API */
        document.getElementById("createAPIForm").addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = document.getElementById("createBtn");
            btn.innerHTML = `<i class="fas fa-circle-notch animate-spin mr-2"></i> Deploying...`;

            const rootRoute = e.target.rootRoute.value;
            const expiresAt = e.target.expiresAt.value;

            const res = await fetch("/config/create-api-config", {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
                body: JSON.stringify({ rootRoute, allMethodsAllowed: true, expiresAt })
            });

            if (res.ok) {
                showModal(`<div class="text-center py-8">
                    <div class="w-20 h-20 bg-green-500/20 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl"><i class="fas fa-check"></i></div>
                    <h2 class="text-2xl font-bold mb-2">API Successfully Deployed!</h2>
                    <p class="text-gray-400">Your new endpoint is ready for integration.</p>
                </div>`);
                loadDashboard();
            } else {
                const data = await res.json();
                showModal(`<p class="text-red-400 p-6">${data.error || "Execution error"}</p>`);
            }
            btn.innerHTML = `Deploy API`;
        });

        /* MODAL HANDLERS */
        function showModal(html) {
            document.getElementById("modalBody").innerHTML = html;
            document.getElementById("modalOverlay").style.display = "flex";
            document.body.style.overflow = "hidden"; // Prevent body scroll
        }
        function closeModal() {
            document.getElementById("modalOverlay").style.display = "none";
            document.body.style.overflow = "auto";
        }

        function viewEndpoints(rootRoute) {
            const baseURL = window.location.origin;
            const methods = [
                { m: 'GET', url: `/user-api/${rootRoute}/{tag}`, desc: 'Fetch Tag Data' },
                { m: 'GET', url: `/user-api/${rootRoute}/`, desc: 'Fetch All Data' },
                { m: 'POST', url: `/user-api/create/${rootRoute}/{tag}`, desc: 'Create Entry' },
                { m: 'PATCH', url: `/user-api/${rootRoute}/{docId}`, desc: 'Update by ID' },
                { m: 'DELETE', url: `/user-api/${rootRoute}/{docId}`, desc: 'Delete by ID' }
            ];

            let html = `
                <div class="mb-6 pr-8">
                    <h2 class="text-xl md:text-2xl font-bold mb-2">Endpoint Reference</h2>
                    <p class="text-gray-400 text-xs">Route: <span class="text-indigo-400 font-mono">/${rootRoute}</span></p>
                </div>

                <div class="bg-indigo-500/10 border border-indigo-500/30 rounded-2xl p-4 mb-6">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-info-circle text-indigo-400 mt-1"></i>
                        <div>
                            <h4 class="text-xs font-bold text-indigo-300 uppercase tracking-tight">Pro Tip: What is a {tag}?</h4>
                            <p class="text-[11px] text-gray-300 leading-relaxed mt-1">
                                A <b>tag</b> is your collection name (like <code class="text-white">users</code> or <code class="text-white">posts</code>). 
                                No setup needed—just send data to a tag, and we'll create it instantly.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">`;

            methods.forEach(item => {
                html += `
                <div class="bg-black/40 p-4 rounded-2xl border border-white/5 font-mono text-[10px] md:text-xs group relative">
                    <div class="flex justify-between text-gray-500 mb-2 uppercase tracking-tighter">
                        <span class="font-sans font-bold">${item.desc}</span> 
                        <span class="text-indigo-400 font-bold">${item.m}</span>
                    </div>
                    <div class="text-white break-all pr-8">${baseURL}${item.url}</div>
                    <button onclick="copyToClipboard('${baseURL}${item.url}')" class="absolute right-4 bottom-4 text-gray-500 hover:text-white">
                        <i class="far fa-copy"></i>
                    </button>
                </div>`;
            });

            html += `</div>
            <div class="mt-8">
                <button onclick="closeModal()" class="w-full py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 font-bold transition-all shadow-lg shadow-indigo-500/20">Got it, thanks!</button>
            </div>`;

            showModal(html);
        }

        async function deleteAPI(configId) {
            showModal(`<div class="text-center py-4">
                <i class="fas fa-exclamation-triangle text-red-500 text-5xl mb-6"></i>
                <h2 class="text-xl font-bold mb-4">Are you absolutely sure?</h2>
                <p class="text-gray-400 mb-8 text-sm">This will permanently delete your API and all stored JSON data.</p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <button onclick="closeModal()" class="flex-1 py-4 rounded-xl bg-white/5 font-bold order-2 sm:order-1">Cancel</button>
                    <button onclick="confirmDelete('${configId}')" class="flex-1 py-4 rounded-xl bg-red-500 hover:bg-red-600 font-bold order-1 sm:order-2">Delete API</button>
                </div>
            </div>`);
        }

        async function confirmDelete(configId) {
            const res = await fetch("/config/delete-api-config", {
                method: "DELETE",
                headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
                body: JSON.stringify({ configId })
            });
            if (res.ok) { closeModal(); loadDashboard(); }
        }

        function showUpdateModal(configId, route) {

            showModal(`
<h2 class="text-xl font-bold mb-6 text-center">Update API</h2>

<div class="space-y-4">

<div class="space-y-2">
<label class="text-[10px] font-bold text-gray-500 uppercase ml-1">
Route Name
</label>
<input id="updRoute"
type="text"
value="${route}"
class="input-glass w-full rounded-xl p-4 text-sm">
</div>

<div class="space-y-2">
<label class="text-[10px] font-bold text-gray-500 uppercase ml-1">
Expiry Date
</label>
<input id="updDate"
type="date"
class="input-glass w-full rounded-xl p-4 text-sm">
</div>

<button
onclick="confirmUpdate('${configId}')"
class="w-full bg-indigo-600 py-4 mt-2 rounded-xl font-bold shadow-lg shadow-indigo-500/20">
Save Changes
</button>

</div>
`)
        }

        async function confirmUpdate(configId) {

            const route = document.getElementById("updRoute").value
            const date = document.getElementById("updDate").value

            const updatedConfigs = {}

            if (route && route.trim() !== "") {
                updatedConfigs.rootRoute = route
            }

            if (date && date.trim() !== "") {
                updatedConfigs.expiresAt = date
            }

            const res = await fetch("/config/update-api-config", {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + token
                },
                body: JSON.stringify({
                    configId,
                    updatedConfigs
                })
            })

            const data = await res.json()

            if (res.ok) {
                closeModal()
                loadDashboard()
            } else {
                alert(data.error || "Update failed")
            }

        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text);
            // Flash copy icon feedback could go here
        }

        function logout() {
            localStorage.clear();
            window.location.href = "/login";
        }

        loadDashboard();

        function setDefaultExpiry() {

            const input = document.getElementById("expiryInput")

            const today = new Date()

            today.setDate(today.getDate() + 28)

            const yyyy = today.getFullYear()
            const mm = String(today.getMonth() + 1).padStart(2, '0')
            const dd = String(today.getDate()).padStart(2, '0')

            input.value = `${yyyy}-${mm}-${dd}`

        }

        setDefaultExpiry()
    </script>
</body>

</html>